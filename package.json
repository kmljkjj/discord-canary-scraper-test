{
  "name": "discord-canary-scraper",
  "version": "2.4.0",
  "private": true,
  "description": "Discord Canary datamining — builds, experiments, strings, routes",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "scrape": "node src/index.js",
    "quests": "node src/quests.js",
    "mobile": "node src/mobile_versions.js",
    "apex": "node src/apex_rollouts.js",
    "user-rollouts": "node src/user_rollouts.js",
    "shop": "node src/shop.js",
    "blog": "node src/blog_tracker.js",
    "x-news": "node src/x_news.js",
    "x-watch": "node src/x_watch.js",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "verify": "npm run check && npm run lint && npm test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=scripts/** test/*.test.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^15.15.0"
  }
}
